{
  "name": "outsera-testes-web-e2e",
  "version": "0.1.0",
  "private": true,
  "cypress-cucumber-preprocessor": {
    "stepDefinitions": "cypress/e2e/step-definitions/**/*.ts"
  },
  "scripts": {
    "cy:open": "cypress open",
    "cy:run": "cypress run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "verificar:cypress": "cypress verify",
    "smoke": "cypress run --env tags=@smoke",
    "funcional": "cypress run --spec \"cypress/e2e/features/autenticacao.feature,cypress/e2e/features/checkout.feature\" --env tags=@regressao",
    "acessibilidade": "cypress run --spec cypress/e2e/features/acessibilidade.feature --env tags=@acessibilidade",
    "regressao": "cypress run --env tags=@regressao",
    "relatorio": "allure generate allure-results --clean -o allure-report"
  },
  "devDependencies": {
    "@badeball/cypress-cucumber-preprocessor": "22.0.1",
    "@bahmutov/cypress-esbuild-preprocessor": "2.2.4",
    "@eslint/js": "10.0.1",
    "allure-commandline": "2.30.0",
    "allure-cypress": "3.0.8",
    "axe-core": "4.12.1",
    "cypress": "14.0.1",
    "cypress-axe": "1.7.0",
    "cypress-on-fix": "1.1.0",
    "eslint": "10.7.0",
    "typescript": "5.7.3",
    "typescript-eslint": "8.64.0"
  }
}
