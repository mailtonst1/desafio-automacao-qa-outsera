{
  "name": "outsera-testes-web-e2e",
  "version": "0.1.0",
  "private": true,
  "cypress-cucumber-preprocessor": {
    "stepDefinitions": "cypress/e2e/step-definitions/**/*.ts"
  },
  "scripts": {
    "cy:open": "cypress open",
    "cy:run": "cypress run",
    "typecheck": "tsc --noEmit",
    "verificar:cypress": "cypress verify",
    "smoke": "cypress run --env tags=@smoke",
    "regressao": "cypress run --env tags=@regressao",
    "relatorio": "allure generate allure-results --clean -o allure-report"
  },
  "devDependencies": {
    "@badeball/cypress-cucumber-preprocessor": "22.0.1",
    "@bahmutov/cypress-esbuild-preprocessor": "2.2.4",
    "allure-commandline": "2.30.0",
    "allure-cypress": "3.0.8",
    "cypress": "14.0.1",
    "cypress-on-fix": "1.1.0",
    "typescript": "5.7.3"
  }
}
